--- /dev/null
+++ w/tests/output/MonitorFrameScheduler.cpp
@@ -0,0 +1,22 @@
+#include <output/MonitorFrameScheduler.hpp>
+
+#include <gtest/gtest.h>
+
+using namespace Monitor;
+
+TEST(MonitorFrameScheduler, MissedFrameWaitsForPresentation) {
+    CMonitorFrameScheduler scheduler(nullptr);
+
+    EXPECT_TRUE(scheduler.rendersAtFrame());
+    scheduler.onMissedFrame();
+    EXPECT_FALSE(scheduler.rendersAtFrame());
+}
+
+TEST(MonitorFrameScheduler, FailedCommitAfterMissedFrameRendersAgain) {
+    CMonitorFrameScheduler scheduler(nullptr);
+
+    scheduler.onMissedFrame();
+    // The pending frame's commit fails, so it is never presented and onPresented() never comes.
+    scheduler.onCommitFailed();
+    EXPECT_TRUE(scheduler.rendersAtFrame());
+}
