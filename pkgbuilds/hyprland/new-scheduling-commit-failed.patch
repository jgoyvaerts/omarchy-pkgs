+void CMonitorFrameScheduler::onMissedFrame() {
+    m_pendingThird  = true;
+    m_renderAtFrame = false; // block frame rendering, we already scheduled
+}
+
+void CMonitorFrameScheduler::onCommitFailed() {
+    // A frame that failed to commit is never presented, so onPresented() will not come to commit the
+    // pending one or re-enable rendering. Render again at the next frame event instead.
+    m_pendingThird  = false;
+    m_renderAtFrame = true;
+}
+
+bool CMonitorFrameScheduler::rendersAtFrame() const {
+    return m_renderAtFrame;
+}
